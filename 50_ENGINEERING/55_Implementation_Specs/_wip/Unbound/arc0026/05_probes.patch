using "Rush_Arcana_Created_Aspect_LeapOfFaith"
data "Cooldown" ""
data "SpellProperties" ""
data "DisplayName" "{{PROBE26_LEAP_NAME}}"
data "Description" "{{PROBE26_LEAP_DESC}}"
