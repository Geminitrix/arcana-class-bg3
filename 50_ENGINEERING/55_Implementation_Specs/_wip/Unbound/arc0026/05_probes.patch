@file Spell_Rush
@section -
# Rush_SpringAttack is a weapon action: its cooldown, recharge, weapon type, weapon flag and weapon requirement are
# overridden here (as Leap of Faith does), or the probe asks for an equipped weapon and recharges on a Short Rest.
new entry "Rush_Arcana_Util_PROBE_Rush"
type "SpellData"
data "SpellType" "Rush"
using "Rush_SpringAttack"
data "Level" "0"
data "Cooldown" ""
data "RechargeValues" ""
data "WeaponTypes" ""
data "RequirementConditions" ""
data "TargetRadius" "9"
data "MovementSpeed" "60000"
data "SpellRoll" "Attack(AttackType.MeleeUnarmedAttack)"
data "SpellSuccess" "DealDamage(UnarmedDamage,Bludgeoning)"
data "TargetConditions" "Character() and Enemy() and not Dead() and not HasStatus('PROBE_ARC0026_MARK') and not HasPassive('ARCANA_IS_SPELL', context.Source)"
data "Icon" "Action_Monk_StepOfTheWind_Dash"
data "DisplayName" "{{PROBE26_RUSH_NAME}}"
data "Description" "{{PROBE26_RUSH_DESC}}"
data "UseCosts" "BonusActionPoint:1;"
data "SpellFlags" "IsMelee;IsHarmful"
data "DamageType" "Bludgeoning"
data "Sheathing" "DontChange"

new entry "Rush_Arcana_Util_PROBE_Leap"
type "SpellData"
