# ===== ARC-0026 stage 4 — ranks, Weightless, the cards (WB6, WB7, WB16, WB17, WB29–WB43, WB47) =====
# Texts: approved (00_texts.md B9, C14, F3–F10); the rank passives' texts (Gale, Storm) are an addendum to the gate
# (32.04/ARC-0026_Windborn.md). Values: 25 FEAT_Unbound_TheOpenRoad, FEAT_Unbound_Weightless, SPL_Unbound_FlowState,
# SPL_Unbound_StormFists, SPL_Unbound_Untethered, SPL_Unbound_LeapOfFaith, SPL_Unbound_GaleDeflection, CLS_Unbound.
# Removals here go with their progression rows in 50_structure.pl (same stage). Variants with hand-edited fields
# (gen_upcast_variants keeps them) are set one by one.

# Keys defined in an earlier patch are repeated (same text) so each stage applies on its own.
@loca WB_BAG_NAME Aeolus' Bag

# --- Ranks: hidden marker of the bag (level 2) and the three visible rank passives (4, 8, 12).
@loca WB_RANK_GALE Zephyr Strike: Gale
@loca WB_RANK_GALE_DESC The wind grows. Your Zephyr Strike pushes the target back [1] and carries you farther, the bag's winds blow longer, and <LSTag Type="Spell" Tooltip="Shout_Arcana_Created_AeolusBag_Eurus">Eurus</LSTag> joins <LSTag Type="Spell" Tooltip="Shout_Arcana_Created_AeolusBag">Aeolus' Bag</LSTag>.
@loca WB_RANK_STORM Zephyr Strike: Storm
@loca WB_RANK_STORM_DESC The wind doesn't stop. After a Zephyr Strike carries you to an enemy, the wind can carry you to one more, and the bag's winds blow longer.
@loca WB_RANK_HURRICANE Hurricane
@loca WB_RANK_HURRICANE_DESC When you open Aeolus' Bag, you release two winds at once.
@loca WB_STORM_RUSH_NAME Storm: The Wind Doesn't Stop
@loca WB_STORM_RUSH_DESC The wind can carry you to one more enemy that isn't <LSTag Type="Status" Tooltip="ARCANA_WINDSWEPT">Windswept</LSTag> this turn.
@file Passive
@section UNBOUND PASSIVES
new entry "Arcana_Passive_AeolusBag"
type "PassiveData"
data "DisplayName" "{{WB_BAG_NAME}}"
data "Properties" "IsHidden"

new entry "Arcana_Passive_Zephyr_Gale"
type "PassiveData"
data "DisplayName" "{{WB_RANK_GALE}}"
data "Description" "{{WB_RANK_GALE_DESC}}"
data "DescriptionParams" "Distance(3)"
data "Icon" "Action_Monk_FreeUnarmedStrike"
data "Properties" "Highlighted"

new entry "Arcana_Passive_Zephyr_Storm"
type "PassiveData"
data "DisplayName" "{{WB_RANK_STORM}}"
data "Description" "{{WB_RANK_STORM_DESC}}"
data "Icon" "Action_Monk_StepOfTheWind_Dash"
data "Properties" "Highlighted"
data "StatsFunctorContext" "OnAttack"
data "Conditions" "SpellId('Rush_Arcana_Created_ZephyrRush') and not IsMiss() and not IsCriticalMiss() and not WearingArmor(context.Source) and not HasShieldEquipped(context.Source)"
data "StatsFunctors" "ApplyStatus(SELF,ARCANA_STORM_RUSH,100,1)"

new entry "Arcana_Passive_Zephyr_Hurricane"
type "PassiveData"
data "DisplayName" "{{WB_RANK_HURRICANE}}"
data "Description" "{{WB_RANK_HURRICANE_DESC}}"
data "Icon" "Spell_Evocation_GustOfWind"
data "Properties" "Highlighted"

# Storm's second Rush: free, 9 m, consumed when cast; unlocked for the turn by the Storm passive.
@file Status_BOOST
@section UNBOUND STATUS
new entry "ARCANA_STORM_RUSH"
type "StatusData"
data "StatusType" "BOOST"
data "DisplayName" "{{WB_STORM_RUSH_NAME}}"
data "Description" "{{WB_STORM_RUSH_DESC}}"
data "Icon" "Action_Monk_StepOfTheWind_Dash"
data "StackId" "ARCANA_STORM_RUSH"
data "TickType" "EndTurn"
data "Boosts" "UnlockSpell(Rush_Arcana_Created_ZephyrRush_Storm);"
data "RemoveConditions" "WearingArmor(context.Source) or HasShieldEquipped(context.Source)"
data "RemoveEvents" "OnEquip;OnCombatEnded"
data "StatusPropertyFlags" "ForceOverhead"

@file Spell_Rush
@section -
new entry "Rush_Arcana_Created_ZephyrRush_Storm"
type "SpellData"
data "SpellType" "Rush"
using "Rush_Arcana_Created_ZephyrRush"
data "SpellProperties" "RemoveStatus(SELF,ARCANA_STORM_RUSH);IF(not Player(context.Source)):ApplyStatus(SELF,AI_HELPER_EXTRAATTACK,100,1);"
data "TargetRadius" "9"
data "TargetConditions" "Character() and Enemy() and not Dead() and not HasStatus('ARCANA_WINDSWEPT') and not HasPassive('ARCANA_IS_CARD', context.Source)"
data "DisplayName" "{{WB_STORM_RUSH_NAME}}"
data "Description" "{{WB_STORM_RUSH_DESC}}"
data "UseCosts" ""

# --- Weightless (WB39, WB47): four ranks replace Twinkle Toes (12 entries) and Feather Fall (Weightless_5–_12).
# Four entries written by hand: a generator table for four rows would be more code than the rows (T3 is about dozens).
@loca WB_WEIGHTLESS Weightless
@loca WB_WEIGHTLESS_1_DESC You move as if the air carried you. Your movement speed increases by [1].
@loca WB_WEIGHTLESS_2_DESC You move as if the air carried you. Your movement speed increases by [1], your jumps reach [2] times as far, and you take only half Falling damage.
@loca WB_WEIGHTLESS_4_DESC You move as if the air carried you. Your movement speed increases by [1], your jumps reach [2] times as far, and you are <LSTag Tooltip="Immune">Immune</LSTag> to Falling damage.
@file Passive
@section UNBOUND PASSIVES
new entry "Arcana_Passive_Weightless_1"
type "PassiveData"
data "DisplayName" "{{WB_WEIGHTLESS}}"
data "Description" "{{WB_WEIGHTLESS_1_DESC}}"
data "DescriptionParams" "Distance(3)"
data "ExtraDescription" "{{h73613d54g9e1dg231dg03c1gcb8d2ba41166}}"
data "Icon" "PassiveFeature_UnarmoredMovement"
data "Properties" "Highlighted"
data "BoostContext" "OnEquip;OnCreate"
data "BoostConditions" "not WearingArmor(context.Source) and not HasShieldEquipped(context.Source)"
data "Boosts" "ActionResource(Movement,3,0);"

new entry "Arcana_Passive_Weightless_4"
type "PassiveData"
using "Arcana_Passive_Weightless_1"
data "Description" "{{WB_WEIGHTLESS_2_DESC}}"
data "DescriptionParams" "Distance(4.5);2"
data "Boosts" "ActionResource(Movement,4.5,0);JumpMaxDistanceMultiplier(2);FallDamageMultiplier(0.5);"

new entry "Arcana_Passive_Weightless_8"
type "PassiveData"
using "Arcana_Passive_Weightless_1"
data "Description" "{{WB_WEIGHTLESS_2_DESC}}"
data "DescriptionParams" "Distance(6);3"
data "Boosts" "ActionResource(Movement,6,0);JumpMaxDistanceMultiplier(3);FallDamageMultiplier(0.5);"

new entry "Arcana_Passive_Weightless_12"
type "PassiveData"
using "Arcana_Passive_Weightless_1"
data "Description" "{{WB_WEIGHTLESS_4_DESC}}"
data "DescriptionParams" "Distance(9);4"
data "Boosts" "ActionResource(Movement,9,0);JumpMaxDistanceMultiplier(4);FallDamageMultiplier(0);"

