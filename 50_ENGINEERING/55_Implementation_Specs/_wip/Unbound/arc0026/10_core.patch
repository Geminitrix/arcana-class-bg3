# ===== ARC-0026 stage 2 — the Open Road (WB3, WB5, WB8–WB10, WB18, WB27, WB28) =====
# Texts: approved (32.04/ARC-0026_Windborn.md, 00_texts.md B1–B8, F1–F2). Values: 25 FEAT_Unbound_TheOpenRoad.
# Written before the probes: P2 (one Rush Zephyr), P6 (the Open Path: plan B, the AoO override), P7 (marks) may switch a block to its
# plan B (SPEC_ARC-0026 §Probes). Internal ids keep their names (ADR-0002).
# Ranks (Gale range and push, Storm) are read through Arcana_Passive_Zephyr_Gale, created in 30_ranks_cards.patch;
# until then HasPassive() is false and Zephyr plays the Breeze rank.
# gen_upcast_variants keeps the fields a variant edits by hand ("175 variants with edited fields preserved"), so
# Gale Burst _3–_6 (own SpellSuccess) get the mark below too; Wind Blast's variants inherit it from the base.

# --- Windswept: the mark (WB8, WB9). Lasts until the end of her next turn: 2 ticks on HER turn ends (TickingWithSource).
# shortcut: a mark applied on an enemy's turn (Riposte, Deflection) lasts one turn of hers longer; fine unless V1 says otherwise.
@loca WB_WINDSWEPT_NAME Windswept
@loca WB_WINDSWEPT_DESC Touched by the wind. Can't make Opportunity Attacks.<br><br>Suffers the bane of any wind the Windborn releases.
@file Status_BOOST
@section UNBOUND STATUS
new entry "ARCANA_WINDSWEPT"
type "StatusData"
data "StatusType" "BOOST"
data "DisplayName" "{{WB_WINDSWEPT_NAME}}"
data "Description" "{{WB_WINDSWEPT_DESC}}"
data "Icon" "Spell_Evocation_GustOfWind"
data "StackId" "ARCANA_WINDSWEPT"
data "StackType" "Overwrite"
data "TickType" "EndTurn"
data "StatusPropertyFlags" "TickingWithSource;ForceOverhead"
data "RemoveEvents" "OnCombatEnded"

# --- The Open Path (WB10), plan B of P6 (QA-0004): the vanilla Mobile pair failed; the Owner copied vanilla
# Interrupt_AttackOfOpportunity into the mod (Interrupt.txt, 2026-10-17) and a Windswept reactor is switched off in its
# EnableCondition, as SG_Blinded already is. Stage 2 points it from the probe mark to Windswept.
# shortcut: overrides a vanilla interrupt (a mod that edits it too wins or loses by load order); revisit on a conflict report.
@file Interrupt
@set Interrupt_AttackOfOpportunity EnableCondition "not HasStatus('SG_Blinded') and not HasStatus('ARCANA_WINDSWEPT');"

# --- Zephyr Strike: the core grant. True Strike leaves (WB29); the rule text is taught here once (WB27).
@loca h99c87996ge8c7g0090gfd52g5145a4e60f30 The Open Road
@loca h1e5b5d84gf8fag7d7bgc878g960616bd7ae2 Every enemy you hit, or that fails a <LSTag Tooltip="SavingThrow">Saving Throw</LSTag> against you, becomes <LSTag Type="Status" Tooltip="ARCANA_WINDSWEPT">Windswept</LSTag>. After an unarmed attack or a card, you can make a <LSTag Type="Spell" Tooltip="Target_Arcana_Created_ZephyrStrike">Zephyr Strike</LSTag> as a bonus action - against an enemy that isn't Windswept, the wind carries you to it.
@loca WB_OPENROAD_EXTRA Windswept lasts until the end of your next turn. Windswept enemies can't make Opportunity Attacks.<br><br>Only active while not wearing armour or using a shield.
@file Passive
@set Arcana_Passive_FlowingStrikeZephyr DescriptionParams ""
@set Arcana_Passive_FlowingStrikeZephyr ExtraDescription {{WB_OPENROAD_EXTRA}}
@set Arcana_Passive_FlowingStrikeZephyr Conditions "((IsMeleeAttack() and IsMonkWeaponAttack() and not SpellId('Target_UnarmedStrike_Monk')) or IsCardSpell()) and not WearingArmor(context.Source) and not HasShieldEquipped(context.Source);"

# --- The mark on damage (hers; Tier II adds her allies' in 20_bag_awakening.patch). Hidden: The Open Road explains it.
# P7 (QA-0004): OnAttack marked only on a weapon attack; the Owner's fix is OnDamage with damage done, so a miss marks nothing.
@section UNBOUND PASSIVES
new entry "Arcana_Passive_Windswept_Touch"
type "PassiveData"
data "DisplayName" "{{WB_WINDSWEPT_NAME}}"
data "Properties" "IsHidden"
data "StatsFunctorContext" "OnDamage"
data "Conditions" "Enemy() and TotalDamageDoneGreaterThan(0) and not WearingArmor(context.Source) and not HasShieldEquipped(context.Source)"
data "StatsFunctors" "ApplyStatus(ARCANA_WINDSWEPT,100,2)"

# --- Zephyr Strike, P2 plan A (two created cards): the strike stays (Target_Arcana_Created_ZephyrStrike — Wind Riposte
# inherits it, CardDB / families / FOOL_ZEPHYR_FREE key on it) and gains the Gale push; the Rush is a new card,
# unlocked by a twin status so the PC deck conjures it too (CardDB statusConjures: one card per status, lua/CardDB.patch).
# stats_add requires the Rush_ prefix for a Rush. Animation: Rush_SpringAttack (WB5). Both cost the bonus action.
@loca WB_ZEPHYR_RUSH_DESC Ride the wind to an enemy it hasn't touched yet and strike it with an open hand.
@loca WB_ZEPHYR_EXTRA Only an enemy that isn't <LSTag Type="Status" Tooltip="ARCANA_WINDSWEPT">Windswept</LSTag>.<br><br>Gale: the strike pushes the target back.<br>Storm: after this strike, the wind can carry you to one more.<br><br>Can only be used while not wearing armour or using a shield.
@file Spell_Target
@set Target_Arcana_Created_ZephyrStrike SpellSuccess "DealDamage(UnarmedDamage,Bludgeoning);IF(HasPassive('Arcana_Passive_Zephyr_Gale',context.Source)):Force(3);"
@file Spell_Rush
@section -
new entry "Rush_Arcana_Created_ZephyrRush"
type "SpellData"
data "SpellType" "Rush"
using "Rush_SpringAttack"
data "Level" "1"
data "Cooldown" ""
data "RechargeValues" ""
data "WeaponTypes" ""
data "SpellProperties" "IF(not Player(context.Source)):ApplyStatus(SELF,AI_HELPER_EXTRAATTACK,100,1);"
data "TargetRadius" "12"
data "MovementSpeed" "60000"
data "SpellRoll" "Attack(AttackType.MeleeUnarmedAttack)"
data "SpellSuccess" "DealDamage(UnarmedDamage,Bludgeoning);IF(HasPassive('Arcana_Passive_Zephyr_Gale',context.Source)):Force(3);"
data "TargetConditions" "Character() and Enemy() and not Dead() and not HasStatus('ARCANA_WINDSWEPT') and not HasPassive('ARCANA_IS_CARD', context.Source) and (DistanceToTargetLessThan(9) or HasPassive('Arcana_Passive_Zephyr_Gale', context.Source))"
data "RequirementConditions" "not HasStatus('SG_Polymorph_BeastShape') and not WearingArmor(context.Source) and not HasShieldEquipped(context.Source);"
data "Requirements" "!Immobile"
data "Icon" "Action_Monk_StepOfTheWind_Dash"
data "DisplayName" "{{h56bc27caga588g2b1agc487ge918b523cedf}}"
data "Description" "{{WB_ZEPHYR_RUSH_DESC}}"
data "ExtraDescription" "{{WB_ZEPHYR_EXTRA}}"
data "TooltipDamageList" "DealDamage(UnarmedDamage,Bludgeoning)"
data "TooltipAttackSave" "MeleeUnarmedAttack"
data "TooltipStatusApply" ""
data "UseCosts" "BonusActionPoint:1;"
data "SpellFlags" "IsMelee;IsHarmful;Temporary;DisableBlood"
data "DamageType" "Bludgeoning"
data "Sheathing" "DontChange"

@file Status_BOOST
@section UNBOUND STATUS
new entry "ARCANA_ZEPHYR_RUSH"
type "StatusData"
data "StatusType" "BOOST"
data "DisplayName" "{{h939a9ea3gfbabg50bbgaa8fga3efd4c6de88}}"
data "Description" "{{h56efad21g20d8gbfd6g293dg4e2c421af268}}"
data "Icon" "Action_Monk_StepOfTheWind_Dash"
data "StackId" "ARCANA_ZEPHYR_RUSH"
data "TickType" "StartTurn"
data "Boosts" "UnlockSpell(Rush_Arcana_Created_ZephyrRush);"
data "RemoveConditions" "WearingArmor(context.Source) or HasShieldEquipped(context.Source)"
data "RemoveEvents" "OnEquip"
data "StatusPropertyFlags" "DisableOverhead;DisableCombatlog;DisablePortraitIndicator"

@file Passive
@set Arcana_Passive_FlowingStrikeZephyr StatsFunctors "ApplyStatus(SELF,ZEPHYR_STRIKE,100,1);ApplyStatus(SELF,ARCANA_ZEPHYR_RUSH,100,1)"

# --- Marks on a failed save (WB8): the Windborn's save cards (the capstone carries its own in 40). Gale Burst loses its
# free unarmed strike (WB28) and both lose "Afterwards…" (WB27).
# shortcut: Weaver Hand (base-class) save spells don't mark; a passive on saves needs an engine hook — P7 asks.
@loca hc3b60f05g2de4ge349g47cdgbfd318148ba4 Channel the air into your fist and release it in a focused burst, launching your target backwards [1] and knocking it <LSTag Type="Status" Tooltip="PRONE">Prone</LSTag>.
@loca h4d2c7825gb331gaf07gcd46g2c58bd100639 Bend the air to unleash a strong gust of wind that clears clouds and pushes creatures back [1], leaving them <LSTag Type="Status" Tooltip="OFF_BALANCED">Off Balance</LSTag>.
@file Spell_Target
@set Target_Arcana_Card_Spell_GaleBurst SpellProperties ""
@set Target_Arcana_Card_Spell_GaleBurst SpellSuccess "DealDamage(1d10,Thunder);Force(6);ApplyStatus(PRONE,100,1);ApplyStatus(ARCANA_WINDSWEPT,100,2);"
@set Target_Arcana_Card_Spell_GaleBurst_3 SpellSuccess "DealDamage(2d10,Thunder);Force(7);ApplyStatus(PRONE,100,1);ApplyStatus(ARCANA_WINDSWEPT,100,2);"
@set Target_Arcana_Card_Spell_GaleBurst_4 SpellSuccess "DealDamage(2d10,Thunder);Force(7);ApplyStatus(PRONE,100,1);ApplyStatus(ARCANA_WINDSWEPT,100,2);"
@set Target_Arcana_Card_Spell_GaleBurst_5 SpellSuccess "DealDamage(3d10,Thunder);Force(8);ApplyStatus(PRONE,100,1);ApplyStatus(ARCANA_WINDSWEPT,100,2);"
@set Target_Arcana_Card_Spell_GaleBurst_6 SpellSuccess "DealDamage(3d10,Thunder);Force(8);ApplyStatus(PRONE,100,1);ApplyStatus(ARCANA_WINDSWEPT,100,2);"
@file Spell_Zone
@set Zone_Arcana_Card_Spell_WindBlast SpellSuccess "Force(5);IF(not Item()):ApplyStatus(OFF_BALANCED,100,1);IF(not Item()):ApplyStatus(ARCANA_WINDSWEPT,100,2);"
