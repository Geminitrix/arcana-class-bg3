# ===== The Veil, task 2: Doubles (summon, form, cap, AC layers) =====
# Osiris side: goals/ARCANA_Deceiver_Doubles.txt (replaces ARCANA_Spell_MirrorImage.txt).
# Shapeshift side: rulebook/DoubleOfTheVeil.lsx-fragment.xml (appearance-only rule used by Transform).
# Variant entries (_2.._6, 2 Doubles at slot 3+, 3 at slot 5+) are NOT here: Task 6 regenerates the variants
# from the new level-1 root first, then a later patch sets their SpellProperties (see 20_doubles.md).

@loca DOUBLE_NAME Double of the Veil
@loca DOUBLE_DESC An illusion of the Deceiver. It has 1 <LSTag Tooltip="HitPoints">hit point</LSTag>, can't be healed and acts only through its own spells, Dash and Disengage.<br><br>Cannot be Charmed, Possessed or Dominated, driven mad or made to flee. An enemy that destroys it gains <LSTag Type="Status" Tooltip="DOUBT_1">Doubt</LSTag>.
@loca THE_VEIL_NAME The Veil
@loca THE_VEIL_DESC <LSTag Type="Spell" Tooltip="Target_Arcana_Card_Spell_MirrorImage">Mirror Image</LSTag> summons Doubles: illusions of you with 1 <LSTag Tooltip="HitPoints">hit point</LSTag> that act on their own turn and can <LSTag Type="Spell" Tooltip="Shout_Deceiver_Double_Shatter">Shatter</LSTag>. You can keep 3 Doubles at once, 4 from level 7 and 5 from level 12. A new Double past that limit replaces the oldest.<br><br>You gain +1 <LSTag Tooltip="ArmourClass">Armour Class</LSTag> for each of your Doubles. An enemy that destroys a Double gains <LSTag Type="Status" Tooltip="DOUBT_1">Doubt</LSTag>.<br><br>Your Doubles vanish when combat ends, after a <LSTag Tooltip="LongRest">Long Rest</LSTag> or if you die.
@loca VEIL_CAP4_NAME The Veil: Four Doubles
@loca VEIL_CAP5_NAME The Veil: Five Doubles
@loca TWO_TRUTHS_NAME Two Truths
@loca TWO_TRUTHS_DESC Your Doubles can also cast <LSTag Type="Spell" Tooltip="Projectile_Deceiver_Double_MirrorSigil">Mirror: Sigil of Malice</LSTag> and <LSTag Type="Spell" Tooltip="Target_Deceiver_Double_MirrorChains">Mirror: Ethereal Chains</LSTag>.
@loca UNVEIL_NAME Unveil
@loca UNVEIL_DESC Your Doubles can also cast <LSTag Type="Spell" Tooltip="Target_Deceiver_Double_Unveil">Unveil</LSTag> to swap places with you. Only one Double can do so each round.
@loca VEIL_LAYER_1_NAME The Veil (1)
@loca VEIL_LAYER_2_NAME The Veil (2)
@loca VEIL_LAYER_3_NAME The Veil (3)
@loca VEIL_LAYER_4_NAME The Veil (4)
@loca VEIL_LAYER_5_NAME The Veil (5)
@loca VEIL_LAYER_DESC Hidden among illusory Doubles. <LSTag Tooltip="ArmourClass">Armour Class</LSTag> increased by [1].
# Existing handles: the card's description, and the template's display name ("Clone", used only by
# RootTemplate 8807d230 = ARCANA_CHAR_CreateClone_1 and the loca files).
@loca h805db51fg1ce6g5aa9g3a26g99b6279b2218 Summon a Double of the Veil: an illusion of you with 1 <LSTag Tooltip="HitPoints">hit point</LSTag> that acts on its own turn and can <LSTag Type="Spell" Tooltip="Shout_Deceiver_Double_Shatter">Shatter</LSTag>.
@loca h7ce24c2bg5830g1f25gda97gc927f6e8e6b1 Double of the Veil

# ---------- The card ----------
# Level 4 -> 1. One Double, no stack id (an empty stack id lets several coexist, as vanilla Dancing Lights
# does; the cap is enforced by Osiris). The old clone statuses (MIRROR_IMAGE_TECHNICAL, _CLONE_SCALING) go.
# Range 9 m (user decision 2026-10-06, spec 3.1; vanilla Invoke Duplicity also uses 9).
@set Target_Arcana_Card_Spell_MirrorImage Level 1
@set Target_Arcana_Card_Spell_MirrorImage TargetRadius 9
@set Target_Arcana_Card_Spell_MirrorImage UseCosts ActionPoint:1;SpellSlotsGroup:1:1:1;
@set Target_Arcana_Card_Spell_MirrorImage SpellProperties GROUND:Summon(8807d230-d0f5-4aa5-b6e4-4b36e9da2ec8,-1,,,,DOUBLE_OF_THE_VEIL_TECH);
@remove MIRROR_IMAGE_TECHNICAL
@remove MIRROR_IMAGE_CLONE_SCALING

# The Double has no bonus action (spec D5): its Dismiss becomes free.
@set Shout_Deceiver_Clone_Dismiss UseCosts

# ---------- The Double's fixed stats (spec D4, risk R1) ----------
# Clone_1 is used only by the mod's own templates 8807d230 (ARCANA_CHAR_CreateClone_1) and 4267f207
# (CreateClone_2, referenced nowhere), so it is changed in place. The appearance-only shapeshift rule keeps
# these (DefaultBoosts / Passives / ... KeepOriginal).
# Vitality 1 = 1 HP (vanilla MinorIllusion: Vitality 1). AC = Armor + Dex modifier (vanilla Raven: Armor 10
# from _Base + DEX 14 = AC 12), so Armor 11 + DEX 12 = AC 12. No bonus action, no reaction, no
# Attack of Opportunity. No healing of any kind. No difficulty HP statuses (vanilla MinorIllusion clears them).
@set Clone_1 Vitality 1
@set Clone_1 Armor 11
@set Clone_1 ActionResources ActionPoint:1;Movement:9
@set Clone_1 Passives Arcana_Passive_DoubleOfTheVeil;DarknessRules
@set Clone_1 DefaultBoosts ProficiencyBonus(Skill,Insight);ProficiencyBonus(Skill,Stealth);ProficiencyBonus(Skill,Perception);ProficiencyBonus(Skill,Deception);ProficiencyBonus(Skill,Investigation);BlockRegainHP(Undead;Construct;Living);
@unset Clone_1 DifficultyStatuses

# ---------- Passives ----------
@file Passive
@section DECEIVER PASSIVES

# On her (granted at level 1 by Task 6). Text only; the Doubt statuses test it with HasPassive(...,context.Target).
new entry "Arcana_Passive_TheVeil"
type "PassiveData"
data "DisplayName" "{{THE_VEIL_NAME}}"
data "Description" "{{THE_VEIL_DESC}}"
data "Icon" "Action_Cleric_InvokeDuplicity"
data "Properties" "Highlighted"

# Read by Osiris only (ARCANA_Deceiver_Doubles.txt, QRY_ARCANA_Doubles_OverCap). Granted at 7 and 12 by Task 6.
new entry "Arcana_Passive_VeilCap4"
type "PassiveData"
data "DisplayName" "{{VEIL_CAP4_NAME}}"
data "Properties" "IsHidden"

new entry "Arcana_Passive_VeilCap5"
type "PassiveData"
data "DisplayName" "{{VEIL_CAP5_NAME}}"
data "Properties" "IsHidden"

# Read by Osiris when a Double forms (its kit). Granted at 5 and 9 by Task 6.
new entry "Arcana_Passive_TwoTruths"
type "PassiveData"
data "DisplayName" "{{TWO_TRUTHS_NAME}}"
data "Description" "{{TWO_TRUTHS_DESC}}"
data "Icon" "Spell_Illusion_MirrorImage"
data "Properties" "Highlighted"

new entry "Arcana_Passive_Unveil"
type "PassiveData"
data "DisplayName" "{{UNVEIL_NAME}}"
data "Description" "{{UNVEIL_DESC}}"
data "Icon" "Spell_Conjuration_MistyStep"
data "Properties" "Highlighted"

# On the Double, through Clone_1's Passives. Spec D6: SG_Charmed (covers DOMINATE_PERSON and FRIENDS),
# SG_Mad, SG_Possessed, SG_Dominated, SG_Fleeing (COMMAND_FLEE, FEARED, TURNED). Group names: inventory E4.
# There is no boost that forbids weapon attacks (every Boosts function in the vanilla stats was checked):
# the goal removes the attack spells instead.
new entry "Arcana_Passive_DoubleOfTheVeil"
type "PassiveData"
data "DisplayName" "{{DOUBLE_NAME}}"
data "Description" "{{DOUBLE_DESC}}"
data "Icon" "PassiveFeature_IllusorySelf"
data "Properties" "Highlighted"
data "Boosts" "StatusImmunity(SG_Charmed);StatusImmunity(SG_Mad);StatusImmunity(SG_Possessed);StatusImmunity(SG_Dominated);StatusImmunity(SG_Fleeing);"

# ---------- Statuses ----------
@file Status_INVISIBLE
@section DECEIVER INVISIBLE STATUS

# The Summon status: the marker Osiris reacts to (same shape as the old MIRROR_IMAGE_TECHNICAL). INVISIBLE
# type so the raw template is not seen while it forms; Boosts blanked (no Invisibility()); OnRemoveFunctors
# blanked (the parent would apply INVOKE_DUPLICITY_AURA, which buffs allies). The goal removes it after setup.
new entry "DOUBLE_OF_THE_VEIL_TECH"
type "StatusData"
data "StatusType" "INVISIBLE"
using "INVOKE_DUPLICITY_TECHNICAL"
data "DisplayName" "{{DOUBLE_NAME}}"
data "Boosts" ""
data "RemoveEvents" ""
data "RemoveConditions" ""
data "OnRemoveFunctors" ""
data "StatusGroups" ""
data "StatusEffect" ""

@file Status_BOOST
