# ===== The Veil: Doubt gets its own level-1 passive (UI), 2026-10-07 =====
# The one place that explains Doubt; The Veil now only talks about Doubles. Granted by 60_structure.pl (level 1).
@loca DOUBT_PASSIVE_NAME Doubt
@loca DOUBT_PASSIVE_DESC Your illusions and whispers make enemies doubt what is real. An enemy gains <LSTag Type="Status" Tooltip="DOUBT_1">Doubt</LSTag> when it destroys one of your Doubles, when a <LSTag Type="Spell" Tooltip="Shout_Deceiver_Double_Shatter">Shatter</LSTag> hits it, when your <LSTag Type="Status" Tooltip="SIGIL">Sigil</LSTag> detonates on it, when <LSTag Type="Spell" Tooltip="Target_Arcana_Card_Spell_MaliciousWhispers">Malicious Whispers</LSTag> hits it while marked and when it fails to resist <LSTag Type="Spell" Tooltip="Shout_Arcana_Card_Spell_GrandDeception">Grand Deception</LSTag>.<br><br>Each stack reduces its Wisdom <LSTag Tooltip="SavingThrow">Saving Throws</LSTag> and its <LSTag Tooltip="AttackRoll">Attack Rolls</LSTag> against you and your Doubles by 1. At 3 stacks it becomes <LSTag Type="Status" Tooltip="DELUDED">Deluded</LSTag>.
@loca h8cce4774gc43ag85c1gfbf4g7a2213dd6822 <LSTag Type="Spell" Tooltip="Target_Arcana_Card_Spell_MirrorImage">Mirror Image</LSTag> and <LSTag Type="Spell" Tooltip="Target_Arcana_Card_Spell_Distortion">Distortion</LSTag> summon Doubles: illusions of you with 1 <LSTag Tooltip="HitPoints">hit point</LSTag> that act on their own turn and can <LSTag Type="Spell" Tooltip="Shout_Deceiver_Double_Shatter">Shatter</LSTag>. You can keep 3 Doubles at once, 4 from level 7 and 5 from level 12, and you gain +1 <LSTag Tooltip="ArmourClass">Armour Class</LSTag> for each one.<br><br>Your Doubles vanish when combat ends, after a <LSTag Tooltip="LongRest">Long Rest</LSTag> or if you die.

@file Passive
@section ARCANA PASSIVES

new entry "Arcana_Passive_Doubt"
type "PassiveData"
data "DisplayName" "{{DOUBT_PASSIVE_NAME}}"
data "Description" "{{DOUBT_PASSIVE_DESC}}"
data "Icon" "Spell_Illusion_PhantasmalForce"
data "Properties" "Highlighted"

