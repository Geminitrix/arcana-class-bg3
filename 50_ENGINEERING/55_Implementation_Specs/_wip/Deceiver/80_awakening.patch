@loca WHICH_ONE_NAME Ready: Which One?
@loca WHICH_ONE_DESC Until combat ends, once per round, when an attack is about to hit you, you can use your <LSTag Type="ActionResource" Tooltip="ReactionActionPoint">reaction</LSTag> to swap places with your nearest Double. The attack misses, the Double is destroyed in your place and the attacker gains <LSTag Type="Status" Tooltip="DOUBT_1">Doubt</LSTag>.
@loca WHICH_ONE_STATUS_NAME Which One?
@loca WHICH_ONE_STATUS_DESC Once per round, when an attack is about to hit you, you can use your <LSTag Type="ActionResource" Tooltip="ReactionActionPoint">reaction</LSTag> to swap places with your nearest Double. The attack misses and the Double is destroyed in your place.
@loca WHICH_ONE_INTERRUPT_DESC Swap places with your nearest Double: the attack misses, the Double is destroyed in your place and the attacker gains <LSTag Type="Status" Tooltip="DOUBT_1">Doubt</LSTag>.
@loca VEIL_LIFTS_NAME The Veil Lifts
@loca VEIL_LIFTS_DESC Lift the veil all at once: every one of your Doubles shatters and every <LSTag Type="Status" Tooltip="SIGIL">Sigil</LSTag> you laid detonates. Surviving enemies with <LSTag Type="Status" Tooltip="DOUBT_1">Doubt</LSTag> become <LSTag Type="Status" Tooltip="DELUDED">Deluded</LSTag>.

# ---------- Tier I: in the Doubt statuses (the attack's target is her, or one of her Doubles while she is awakened) ----------
@set DOUBT_1 Boosts RollBonus(SavingThrow,-1,Wisdom);IF(HasPassive('Arcana_Passive_TheVeil',context.Target) or HasPassive('Arcana_Passive_DoubleOfTheVeil',context.Target)):RollBonus(Attack,-1);IF(HasStatus('ASPECT_AWAKENED_EMPRESS',context.Target) or (HasPassive('Arcana_Passive_DoubleOfTheVeil',context.Target) and HasStatus('ASPECT_AWAKENED_EMPRESS',GetSummoner(context.Target)))):Disadvantage(AttackRoll);
@set DOUBT_2 Boosts RollBonus(SavingThrow,-2,Wisdom);IF(HasPassive('Arcana_Passive_TheVeil',context.Target) or HasPassive('Arcana_Passive_DoubleOfTheVeil',context.Target)):RollBonus(Attack,-2);IF(HasStatus('ASPECT_AWAKENED_EMPRESS',context.Target) or (HasPassive('Arcana_Passive_DoubleOfTheVeil',context.Target) and HasStatus('ASPECT_AWAKENED_EMPRESS',GetSummoner(context.Target)))):Disadvantage(AttackRoll);
@set DOUBT_3 Boosts RollBonus(SavingThrow,-3,Wisdom);IF(HasPassive('Arcana_Passive_TheVeil',context.Target) or HasPassive('Arcana_Passive_DoubleOfTheVeil',context.Target)):RollBonus(Attack,-3);IF(HasStatus('ASPECT_AWAKENED_EMPRESS',context.Target) or (HasPassive('Arcana_Passive_DoubleOfTheVeil',context.Target) and HasStatus('ASPECT_AWAKENED_EMPRESS',GetSummoner(context.Target)))):Disadvantage(AttackRoll);
# Obsession (Sigil-marked attackers) is gone from the Sigil itself.
@unset SIGIL Boosts

# ---------- Tier III: Which One? replaces Beloved ----------
@set Arcana_Passive_Aspect_Empress_Awakened_III Boosts Ability(Charisma,3);UnlockSpell(Shout_Arcana_Card_Passive_WhichOne);
@remove Interrupt_Arcana_Aspect_Beloved

# ---------- The Veil Lifts replaces Heartbreak ----------
@remove Shout_Arcana_Created_Aspect_Heartbreak
@remove HEARTBREAK_TECH

@file Spell_Shout
@section -

new entry "Shout_Arcana_Card_Passive_WhichOne"
type "SpellData"
data "SpellType" "Shout"
data "Level" "3"
data "SpellSchool" "Illusion"
data "SpellProperties" "ApplyStatus(SELF,WHICH_ONE_READY,100,-1)"
data "TargetConditions" "Self() and not HasPassive('ARCANA_IS_CARD', context.Source)"
data "Icon" "PassiveFeature_IllusorySelf"
data "DisplayName" "{{WHICH_ONE_NAME}}"
data "Description" "{{WHICH_ONE_DESC}}"
data "TooltipStatusApply" "ApplyStatus(WHICH_ONE_READY,100,-1)"
data "PreviewCursor" "Cast"
data "CastTextEvent" "Cast"
data "UseCosts" "SpellSlotsGroup:1:1:3;"
data "VerbalIntent" "Buff"
data "SpellStyleGroup" "Class"
data "SpellFlags" "IsSpell;HasVerbalComponent"
data "HitAnimationType" "None"
data "Requirements" "Combat"
data "RequirementConditions" "not HasStatus('ARCANA_WEAVING',context.Source) and not HasStatus('WHICH_ONE_READY',context.Source)"

new entry "Shout_Arcana_Created_Aspect_VeilLifts"
type "SpellData"
data "SpellType" "Shout"
data "Level" "0"
data "SpellSchool" "Illusion"
data "Cooldown" "OncePerCombat"
data "SpellProperties" "IF(HasStatus('SIGIL', context.Target, context.Source)):DealDamage(LevelMapValue(D4Cantrip),Psychic,Magical);IF(not Dead()):ApplyStatus(VEIL_LIFTS_TECH,100,0)"
data "AreaRadius" "18"
data "TargetConditions" "Character() and Enemy() and not Dead() and not HasPassive('ARCANA_IS_CARD', context.Source)"
data "Icon" "Spell_Illusion_MirrorImage"
data "DisplayName" "{{VEIL_LIFTS_NAME}}"
data "Description" "{{VEIL_LIFTS_DESC}}"
data "DescriptionParams" "DealDamage(LevelMapValue(D4Cantrip),Psychic)"
data "TooltipDamageList" "DealDamage(LevelMapValue(D4Cantrip),Psychic)"
data "TooltipStatusApply" "ApplyStatus(DELUDED,100,1)"
data "PreviewCursor" "Cast"
data "CastTextEvent" "Cast"
data "UseCosts" "ActionPoint:1;"
data "VerbalIntent" "Control"
data "SpellStyleGroup" "Class"
data "SpellFlags" "IsSpell;IsHarmful;HasVerbalComponent"
data "Requirements" "Combat"
data "DamageType" "Psychic"

@file Interrupt
@section -

new entry "Interrupt_Arcana_Aspect_WhichOne"
type "InterruptData"
data "DisplayName" "{{WHICH_ONE_STATUS_NAME}}"
data "Description" "{{WHICH_ONE_INTERRUPT_DESC}}"
data "Icon" "PassiveFeature_IllusorySelf"
data "InterruptContext" "OnPostRoll"
data "InterruptContextScope" "Self"
data "Container" "YesNoDecision"
data "Conditions" "IsAbleToReact(context.Observer) and Self(context.Target,context.Observer) and HasInterruptedAttack() and not AnyEntityIsItem() and IsSetInterruptInteresting(1, context.Source)"
data "Properties" "SetRoll(1);ApplyStatus(OBSERVER_SOURCE,DOUBT_ADD_TECH,100,0);ApplyStatus(OBSERVER_OBSERVER,WHICH_ONE_TECH,100,0);ApplyStatus(OBSERVER_OBSERVER,WHICH_ONE_USED_TECH,100,0)"
data "Cost" "ReactionActionPoint:1;ArcanaReactWhichOne:1"
data "InterruptDefaultValue" "Ask;Enabled"
data "EnableCondition" "HasActionResource('ArcanaReactWhichOne', 1, 0, false, false, context.Source) and HasAnyStatus({'VEIL_LAYER_1','VEIL_LAYER_2','VEIL_LAYER_3','VEIL_LAYER_4','VEIL_LAYER_5'},{},{},context.Source);"
data "EnableContext" "OnActionResourcesChanged;OnStatusApplied;OnStatusRemoved"

@file Passive
@section ARCANA PASSIVES

new entry "Arcana_Passive_WhichOne"
type "PassiveData"
data "DisplayName" "{{WHICH_ONE_STATUS_NAME}}"
data "Description" "{{WHICH_ONE_STATUS_DESC}}"
data "Icon" "PassiveFeature_IllusorySelf"
data "Properties" "IsHidden"
data "Boosts" "UnlockInterrupt(Interrupt_Arcana_Aspect_WhichOne);ActionResource(ArcanaReactWhichOne,1,0)"

