# ===== The Star (Starchild) =====
@loca STAR_AWAKE_NAME 17 - The Star: Awakening
@loca STAR_AWAKE_DESC Heal your allies during a fight to awaken the Aspect of Hope until combat ends. Healing beyond an ally's maximum <LSTag Tooltip="HitPoints">hit points</LSTag> doesn't count. Each goal you reach awakens one more tier.<br><br>Level 3: restore hit points equal to 5 times your level to gain <LSTag Type="Passive" Tooltip="Arcana_Passive_Aspect_Star_I">Beacon</LSTag>.<br><br>Level 7: restore 8 times your level to also gain <LSTag Type="Passive" Tooltip="Arcana_Passive_Aspect_Star_II">Sunrise</LSTag>.<br><br>Level 12: restore 12 times your level to awaken as the <LSTag Type="Passive" Tooltip="Arcana_Passive_Aspect_Star_III">Aspect of Hope</LSTag>.
@loca STAR_I_NAME Beacon
@loca STAR_I_DESC Allies you heal or target with an Arcane spell become <LSTag Type="Status" Tooltip="STAR_MOONLIT">Moonlit</LSTag>: their next attack that hits deals an additional [1] and reduces the target's <LSTag Tooltip="MovementSpeed">movement speed</LSTag>.
@loca STAR_II_NAME Sunrise
@loca STAR_II_DESC Moonlit deals [1] instead, and allies you heal or target with an Arcane spell also become <LSTag Type="Status" Tooltip="STAR_SUNLIT">Sunlit</LSTag>: their next attack that hits deals an additional [2] and sets the target <LSTag Type="Status" Tooltip="BURNING">Burning</LSTag>.
@loca STAR_III_NAME Aspect of Hope
@loca STAR_III_DESC Your Wisdom increases by [1], Sunlit deals [2] instead, and allies you heal or target with an Arcane spell gain <LSTag Type="Status" Tooltip="STAR_ECLIPSE">Eclipse</LSTag>, becoming <LSTag Tooltip="Resistant">Resistant</LSTag> to Cold and Fire damage. The first ally who would be downed during the fight instead regains half their <LSTag Tooltip="HitPoints">hit points</LSTag>.
@loca STAR_AWAKENED_NAME 17 - The Star
@loca STAR_AWAKENED_DESC Awakened as the Aspect of Hope until combat ends.
@loca STAR_PROGRESS_NAME Awakening Progress
@loca STAR_PROGRESS_DESC Progress towards your next Awakening tier, in percent.
@loca MOONLIT_NAME Moonlit
@loca MOONLIT_DESC The next attack that hits deals an additional [1] and reduces the target's <LSTag Tooltip="MovementSpeed">movement speed</LSTag>.
@loca SUNLIT_NAME Sunlit
@loca SUNLIT_DESC The next attack that hits deals an additional [1] and sets the target <LSTag Type="Status" Tooltip="BURNING">Burning</LSTag>.
@loca ECLIPSE_NAME Eclipse
@loca ECLIPSE_DESC <LSTag Tooltip="Resistant">Resistant</LSTag> to Cold and Fire damage.
@loca WISHSTAR_NAME Wish Upon a Star
@loca WISHSTAR_DESC Grant your allies within [1] <LSTag Tooltip="Advantage">Advantage</LSTag> on their next <LSTag Tooltip="AttackRoll">Attack Roll</LSTag>.
@loca WISHSTAR_STATUS_DESC Has <LSTag Tooltip="Advantage">Advantage</LSTag> on the next <LSTag Tooltip="AttackRoll">Attack Roll</LSTag>.
@loca HOPE_NAME Undying Hope
@loca HOPE_DESC The first time this creature would be downed during this fight, it instead regains half its <LSTag Tooltip="HitPoints">hit points</LSTag>.

@file Passive
@section STARCHILD PASSIVES

# so UI: explica o objetivo do Despertar; a contagem continua no Tier I e no Osiris
new entry "Arcana_Passive_Aspect_Star_Awakening"
type "PassiveData"
data "DisplayName" "{{STAR_AWAKE_NAME}}"
data "Description" "{{STAR_AWAKE_DESC}}"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "Highlighted"

new entry "Arcana_Passive_Aspect_Star_I"
type "PassiveData"
data "DisplayName" "{{STAR_I_NAME}}"
data "Description" "{{STAR_I_DESC}}"
data "DescriptionParams" "DealDamage(1d4,Cold)"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "Highlighted"
data "StatsFunctorContext" "OnHeal"
data "Conditions" "Combat() and not Self() and HealDoneGreaterThan(0) and not HasStatus('ASPECT_AWAKENED_STAR', context.Source);"
data "StatsFunctors" "ApplyStatus(BEACON_HEAL_TECH,100,1)"

new entry "Arcana_Passive_Aspect_Star_II"
type "PassiveData"
data "DisplayName" "{{STAR_II_NAME}}"
data "Description" "{{STAR_II_DESC}}"
data "DescriptionParams" "DealDamage(2d4,Cold);DealDamage(1d4,Fire)"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "Highlighted"

new entry "Arcana_Passive_Aspect_Star_III"
type "PassiveData"
data "DisplayName" "{{STAR_III_NAME}}"
data "Description" "{{STAR_III_DESC}}"
data "DescriptionParams" "3;DealDamage(2d4,Fire)"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "Highlighted"

new entry "Arcana_Passive_Aspect_Star_Awakened_Heal"
type "PassiveData"
data "DisplayName" "{{STAR_I_NAME}}"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "IsHidden"
data "StatsFunctorContext" "OnHeal"
data "Conditions" "not Self() and HealDoneGreaterThan(0);"
data "StatsFunctors" "IF(not HasPassive('Arcana_Passive_Aspect_Star_II', context.Source)):ApplyStatus(STAR_MOONLIT,100,2);IF(HasPassive('Arcana_Passive_Aspect_Star_II', context.Source)):ApplyStatus(STAR_MOONLIT_II,100,2);IF(HasPassive('Arcana_Passive_Aspect_Star_II', context.Source) and not HasPassive('Arcana_Passive_Aspect_Star_III', context.Source)):ApplyStatus(STAR_SUNLIT,100,2);IF(HasPassive('Arcana_Passive_Aspect_Star_III', context.Source)):ApplyStatus(STAR_SUNLIT_II,100,2);IF(HasPassive('Arcana_Passive_Aspect_Star_III', context.Source)):ApplyStatus(STAR_ECLIPSE,100,2)"

# Moonlit e Sunlit: a passiva que o status da ao aliado faz tudo no acerto (dano, efeito e tira o status),
# num passo so; um boost que some no OnAttack nao garantiria o efeito junto
new entry "Arcana_Passive_Star_Moonlit"
type "PassiveData"
data "DisplayName" "{{MOONLIT_NAME}}"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "IsHidden"
data "StatsFunctorContext" "OnAttack"
data "Conditions" "IsHit();"
data "StatsFunctors" "DealDamage(1d4,Cold,Magical);ApplyStatus(RAY_OF_FROST,100,1);RemoveStatus(SELF,STAR_MOONLIT)"

new entry "Arcana_Passive_Star_Moonlit_II"
type "PassiveData"
data "DisplayName" "{{MOONLIT_NAME}}"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "IsHidden"
data "StatsFunctorContext" "OnAttack"
data "Conditions" "IsHit();"
data "StatsFunctors" "DealDamage(2d4,Cold,Magical);ApplyStatus(RAY_OF_FROST,100,1);RemoveStatus(SELF,STAR_MOONLIT_II)"

new entry "Arcana_Passive_Star_Sunlit"
type "PassiveData"
data "DisplayName" "{{SUNLIT_NAME}}"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "IsHidden"
data "StatsFunctorContext" "OnAttack"
data "Conditions" "IsHit();"
data "StatsFunctors" "DealDamage(1d4,Fire,Magical);ApplyStatus(BURNING,100,2);RemoveStatus(SELF,STAR_SUNLIT)"

new entry "Arcana_Passive_Star_Sunlit_II"
type "PassiveData"
data "DisplayName" "{{SUNLIT_NAME}}"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "IsHidden"
data "StatsFunctorContext" "OnAttack"
data "Conditions" "IsHit();"
data "StatsFunctors" "DealDamage(2d4,Fire,Magical);ApplyStatus(BURNING,100,2);RemoveStatus(SELF,STAR_SUNLIT_II)"

new entry "Arcana_Passive_Aspect_Star_Awakened_III"
type "PassiveData"
data "DisplayName" "{{STAR_III_NAME}}"
data "Icon" "Spell_Evocation_DancingLights"
data "Properties" "IsHidden"
data "BoostConditions" "HasPassive('Arcana_Passive_Aspect_Star_III', context.Source);"
data "Boosts" "Ability(Wisdom,3);"

