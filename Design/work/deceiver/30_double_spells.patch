# The swap is vanilla's SwapPlaces() functor (Target_LOW_BhaalCultist_BenignTransposition: SwapPlaces() on an ally),
# so Osiris does nothing here. The target is HER: she carries a VEIL_LAYER_N status whose cause is her (applied by the
# Doubles goal with her as source) and the Double's summoner is her (the HasStatus(..., context.Target,
# GetSummoner(context.Source)) shape of vanilla Hunter's Mark and of the SIGIL RemoveConditions). Once per round across
# every Double: the spell applies UNVEIL_USED_TECH to its target (her) and TargetConditions refuses a target that has
# it, so no other Double can pick her until the round ends.
new entry "Target_Deceiver_Double_Unveil"
type "SpellData"
data "SpellType" "Target"
data "SpellProperties" "SwapPlaces();ApplyStatus(UNVEIL_USED_TECH,100,1)"
data "TargetRadius" "18"
data "MaximumTargets" "1"
data "TargetConditions" "Character() and Ally() and not Self() and not Dead() and not HasStatus('UNVEIL_USED_TECH', context.Target) and (HasStatus('VEIL_LAYER_1', context.Target, GetSummoner(context.Source)) or HasStatus('VEIL_LAYER_2', context.Target, GetSummoner(context.Source)) or HasStatus('VEIL_LAYER_3', context.Target, GetSummoner(context.Source)) or HasStatus('VEIL_LAYER_4', context.Target, GetSummoner(context.Source)) or HasStatus('VEIL_LAYER_5', context.Target, GetSummoner(context.Source)))"
